{
  "name": "web-chat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:url": "node scripts/print-dev-url.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build --outDir ../static/dist",
    "lint": "npx --yes @biomejs/biome@2.3.8 ci .",
    "audit:unused": "npx --yes knip --include files,exports --reporter compact",
    "test": "vitest run",
    "lint:fix": "npx --yes @biomejs/biome@2.3.8 check --write .",
    "check": "npm run typecheck && npm run lint",
    "check:storybook": "npm run build-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@go-go-golems/chat-provider": "^0.2.1",
    "@reduxjs/toolkit": "^2.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-redux": "^9.2.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.8",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "storybook": "10.6.8",
    "typescript": "^5.7.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
  }
}
